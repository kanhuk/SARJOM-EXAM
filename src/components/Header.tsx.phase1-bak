"use client";

import Link from "next/link";
import { useCallback, useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import { createClient, type User } from "@supabase/supabase-js";
import LanguageSwitcher from "@/components/language/LanguageSwitcher";

const navigation = [
  { label: "Home", href: "/" },
  { label: "Exams", href: "/exams" },
  { label: "PYQ Practice", href: "/pyq" },
  { label: "Syllabus", href: "/syllabus" },
  { label: "Current Affairs", href: "/current-affairs" },
];

export default function Header() {
  const router = useRouter();
  const [menuOpen, setMenuOpen] = useState(false);
  const [user, setUser] = useState<User | null>(null);
  const [isAdmin, setIsAdmin] = useState(false);
  const [checking, setChecking] = useState(true);
  const [signingOut, setSigningOut] = useState(false);

  const supabase = useMemo(() => createClient(
    process.env.NEXT_PUBLIC_SUPABASE_URL!,
    process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY!
  ), []);

  const refreshIdentity = useCallback(async () => {
    try {
      const adminResponse = await fetch("/api/admin/session", {
        cache: "no-store",
        credentials: "same-origin"
      });
      const adminData = adminResponse.ok ? await adminResponse.json() : null;
      const admin = adminData?.authenticated === true;
      setIsAdmin(admin);

      if (admin) {
        setUser(null);
      } else {
        const { data } = await supabase.auth.getUser();
        setUser(data.user ?? null);
      }
    } catch {
      setIsAdmin(false);
      const { data } = await supabase.auth.getUser();
      setUser(data.user ?? null);
    } finally {
      setChecking(false);
    }
  }, [supabase]);

  useEffect(() => {
    void Promise.resolve().then(() => refreshIdentity());
    const { data: listener } = supabase.auth.onAuthStateChange(() => {
      void refreshIdentity();
    });
    return () => listener.subscription.unsubscribe();
  }, [refreshIdentity, supabase]);

  async function signOut() {
    if (signingOut) return;
    setSigningOut(true);
    try {
      if (isAdmin) {
        const response = await fetch("/api/admin/session", {
          method: "DELETE",
          credentials: "same-origin",
          cache: "no-store"
        });
        if (!response.ok) throw new Error("Admin sign-out failed. Please retry.");
      } else {
        const { error } = await supabase.auth.signOut();
        if (error) throw error;
      }
      setUser(null);
      setIsAdmin(false);
      setMenuOpen(false);
      router.replace("/");
      router.refresh();
    } catch (error) {
      window.alert(error instanceof Error ? error.message : "Sign-out failed.");
    } finally {
      setSigningOut(false);
    }
  }

  const displayName = isAdmin
    ? "KANHU HEMBRAM"
    : String(user?.user_metadata?.full_name || user?.user_metadata?.name || user?.email?.split("@")[0] || "Candidate");

  const accountLinks = (
    <>
      {isAdmin && (
        <Link
          href="/admin"
          className="rounded-lg border border-[#f4b900] px-3 py-2 text-xs font-bold text-[#f4b900] transition hover:bg-[#f4b900] hover:text-black"
        >
          ADMIN DASHBOARD
        </Link>
      )}
      <LanguageSwitcher />
      {checking ? (
        <span className="px-3 py-2 text-sm text-white/60">Checking account…</span>
      ) : isAdmin || user ? (
        <div className="flex max-w-[210px] flex-col items-end gap-1">
          <span className="max-w-[210px] truncate text-xs font-bold uppercase tracking-wide" title={displayName}>
            {displayName}
          </span>
          {isAdmin && <span className="text-[10px] font-bold text-[#f4b900]">ADMIN</span>}
          <button type="button" disabled={signingOut} onClick={signOut}
            className="rounded-md bg-white px-3 py-1.5 text-xs font-bold text-black disabled:opacity-60">
            {signingOut ? "Signing out…" : "Sign out"}
          </button>
        </div>
      ) : (
        <>
          <button type="button" onClick={() => window.dispatchEvent(new CustomEvent("sarjom:auth-modal", { detail: "login" }))} className="rounded-lg border border-white/30 px-4 py-2 text-sm font-semibold transition hover:border-[#f4b900] hover:text-[#f4b900]">
            Login
          </button>
          <button type="button" onClick={() => window.dispatchEvent(new CustomEvent("sarjom:auth-modal", { detail: "signup" }))} className="rounded-lg bg-[#f4b900] px-4 py-2 text-sm font-bold text-black transition hover:bg-[#ffd34f]">
            Sign Up
          </button>
        </>
      )}
    </>
  );

  return (
    <header className="sticky top-0 z-50 border-b border-white/10 bg-[#080808] text-white shadow-lg">
      <div className="mx-auto flex min-h-[76px] max-w-[1600px] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
        <Link href="/" className="flex shrink-0 items-center gap-2" aria-label="SARJOM EXAM Home">
          <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#dff8eb] to-[#c8f0dc] text-[25px]">🌿</span>
          <span className="whitespace-nowrap text-lg font-black tracking-tight sm:text-xl">
            SARJOM <span className="text-[#f4b900]">EXAM</span>
          </span>
        </Link>

        <nav className="hidden items-center gap-5 lg:flex xl:gap-8" aria-label="Main navigation">
          {navigation.map(item => (
            <Link key={item.href} href={item.href}
              className="whitespace-nowrap text-sm font-medium text-white/85 transition hover:text-[#f4b900]">
              {item.label}
            </Link>
          ))}
        </nav>

        <div className="hidden shrink-0 items-center gap-3 sm:flex">{accountLinks}</div>

        <button type="button"
          className="flex h-10 w-10 items-center justify-center rounded-lg border border-white/20 text-xl lg:hidden"
          aria-label={menuOpen ? "Close menu" : "Open menu"}
          aria-expanded={menuOpen}
          onClick={() => setMenuOpen(open => !open)}>
          {menuOpen ? "×" : "☰"}
        </button>
      </div>

      {menuOpen && (
        <nav className="border-t border-white/10 px-4 py-4 lg:hidden" aria-label="Mobile navigation">
          <div className="mx-auto flex max-w-[1600px] flex-col gap-1">
            {navigation.map(item => (
              <Link key={item.href} href={item.href} onClick={() => setMenuOpen(false)}
                className="rounded-lg px-3 py-3 text-sm font-medium hover:bg-white/10 hover:text-[#f4b900]">
                {item.label}
              </Link>
            ))}
            <div className="flex flex-wrap items-center justify-between gap-3 border-t border-white/10 pt-4">
              {accountLinks}
            </div>
          </div>
        </nav>
      )}
    </header>
  );
}


