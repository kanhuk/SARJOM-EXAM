"use client";

import { Suspense, useEffect, useMemo, useState } from "react";
import { useSearchParams } from "next/navigation";
import Link from "next/link";
import { getContent } from "@/lib/api";

const examCatalog: { name: string; category: string; description: string }[] = [
  { name: "Odisha Police SI", category: "Odisha Police Recruitment", description: "Sub-Inspector examination papers" },
  { name: "Odisha Police", category: "Odisha Police Recruitment", description: "Constable and other police recruitment papers" },
  { name: "ASO", category: "Odisha Government Exams", description: "Assistant Section Officer papers" },
  { name: "OSSC CGL", category: "Odisha Government Exams", description: "Combined Graduate Level papers" },
  { name: "OPSC", category: "Odisha Government Exams", description: "State competitive examination papers" },
  { name: "SSC", category: "Central Government Exams", description: "Staff Selection Commission papers" },
];
type Question = {
  id: string;
  title: string;
  officialUrl?: string;
  officialSource?: string;
  metadata: Record<string, unknown>;
};

const text = (v: unknown) => typeof v === "string" ? v : "";
const list = (v: unknown) => Array.isArray(v) ? v.filter((x): x is string => typeof x === "string") : [];

function parseQuestion(record: Record<string, unknown>): Question | null {
  if (record.contentType !== "pyq" || record.status !== "published" ||
      typeof record.id !== "string" || !record.metadata ||
      typeof record.metadata !== "object" || Array.isArray(record.metadata)) return null;
  const m = record.metadata as Record<string, unknown>;
  if (!text(m.question).trim() || list(m.options).length < 2 ||
      typeof m.answerIndex !== "number" || !Number.isInteger(m.answerIndex) ||
      m.answerIndex < 0 || m.answerIndex >= list(m.options).length) return null;
  return {
    id: record.id,
    title: text(record.title) || text(m.question),
    officialUrl: text(record.officialUrl),
    officialSource: text(record.officialSource),
    metadata: m,
  };
}

function PyqContent() {
  const params = useSearchParams();
  const [questions, setQuestions] = useState<Question[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [exam, setExam] = useState(params.get("exam") || "");
  const [subject, setSubject] = useState("");
  const [topic, setTopic] = useState("");
  const [year, setYear] = useState("");
  const [mode, setMode] = useState<"browse" | "attempt" | "result">("browse");
  const [answers, setAnswers] = useState<Record<string, number>>({});
  const [review, setReview] = useState<string[]>([]);
  const [current, setCurrent] = useState(0);
  const [seconds, setSeconds] = useState(0);
  const [duration, setDuration] = useState(30);
  const [submitted, setSubmitted] = useState(false);

  useEffect(() => {
    let active = true;
    getContent("pyq")
      .then((response) => {
        const records = Array.isArray(response.records) ? response.records : [];
        const parsed = records
          .filter((r): r is Record<string, unknown> => typeof r === "object" && r !== null)
          .map(parseQuestion)
          .filter((q): q is Question => q !== null);
        if (active) setQuestions(parsed);
      })
      .catch(() => { if (active) setError("PYQs could not be loaded. Check the SARJOM API connection."); })
      .finally(() => { if (active) setLoading(false); });
    return () => { active = false; };
  }, []);

  useEffect(() => {
    if (mode !== "attempt" || submitted) return;
    const timer = window.setInterval(() => {
      setSeconds((s) => {
        if (s <= 1) {
          window.clearInterval(timer);
          setSubmitted(true);
          setMode("result");
          return 0;
        }
        return s - 1;
      });
    }, 1000);
    return () => window.clearInterval(timer);
  }, [mode, submitted]);

  const exams = useMemo(() => Array.from(new Set(questions.map(q =>
    text(q.metadata.examName || q.metadata.exam).trim()).filter(Boolean))).sort(), [questions]);
  const subjects = useMemo(() => Array.from(new Set(questions
    .filter(q => !exam || text(q.metadata.examName || q.metadata.exam).toLowerCase().includes(exam.toLowerCase()))
    .map(q => text(q.metadata.subject).trim()).filter(Boolean))).sort(), [questions, exam]);
  const years = useMemo(() => Array.from(new Set(questions
    .filter(q => !exam || text(q.metadata.examName || q.metadata.exam).toLowerCase().includes(exam.toLowerCase()))
    .map(q => text(q.metadata.year).trim()).filter(Boolean))).sort().reverse(), [questions, exam]);

  const paperGroups = useMemo(() => {
    const groups = new Map<string, { exam: string; year: string; paper: string; shift: string; count: number }>();
    for (const item of questions) {
      const m = item.metadata;
      const examName = text(m.examName || m.exam) || "Exam not specified";
      const paperName = text(m.paper) || "Paper";
      const yearName = text(m.year) || "Year not specified";
      const shiftName = text(m.shift || m.shiftName || m.set) || "Shift/set not specified";
      const key = [examName, yearName, paperName, shiftName].join("::");
      const existing = groups.get(key);
      if (existing) existing.count += 1;
      else groups.set(key, { exam: examName, year: yearName, paper: paperName, shift: shiftName, count: 1 });
    }
    return Array.from(groups.values()).sort((a, b) =>
      a.exam.localeCompare(b.exam) || b.year.localeCompare(a.year) || a.paper.localeCompare(b.paper)
    );
  }, [questions]);
  const filtered = useMemo(() => questions.filter(q => {
    const m = q.metadata;
    const examName = text(m.examName || m.exam).toLowerCase();
    return (!exam || examName.includes(exam.toLowerCase())) &&
      (!subject || text(m.subject) === subject) &&
      (!topic || text(m.topic).toLowerCase().includes(topic.toLowerCase())) &&
      (!year || text(m.year) === year);
  }), [questions, exam, subject, topic, year]);

  const q = filtered[current];
  const options = q ? list(q.metadata.options) : [];
  const answered = Object.keys(answers).filter(id => filtered.some(item => item.id === id)).length;
  const correct = filtered.filter(item => answers[item.id] === item.metadata.answerIndex).length;
  const fmt = (s: number) => `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;

  function startAttempt() {
    if (!filtered.length) return;
    setAnswers({});
    setReview([]);
    setCurrent(0);
    setSeconds(duration * 60);
    setSubmitted(false);
    setMode("attempt");
  }

  function submitAttempt() {
    if (window.confirm("Submit this attempt and view your result?")) {
      setSubmitted(true);
      setMode("result");
    }
  }

  const btn = "rounded-xl border px-4 py-2 text-sm font-bold transition";
  const primary = "rounded-xl bg-blue-700 px-5 py-3 text-sm font-bold text-white disabled:opacity-40";

  return (
    <main className="mx-auto max-w-6xl px-4 py-8 sm:px-6">
      <header className="rounded-3xl bg-slate-950 p-6 text-white sm:p-9">
        <p className="text-xs font-black uppercase tracking-[0.2em] text-amber-300">SARJOM EXAM · PYQ PRACTICE</p>
        <h1 className="mt-3 text-3xl font-black sm:text-4xl">Previous Year Questions</h1>
        <p className="mt-3 max-w-2xl text-sm leading-6 text-slate-300">
          Choose an exam, filter papers by year and subject, and practise in an exam-style interface.
        </p>
        <div className="mt-5 flex flex-wrap gap-3 text-sm">
          <span className="rounded-full bg-white/10 px-4 py-2">Questions: {questions.length}</span>
          <span className="rounded-full bg-white/10 px-4 py-2">Current selection: {filtered.length}</span>
        </div>
      </header>

      {mode === "browse" && <>
        <section className="mt-6">
          <div className="mb-4">
            <p className="text-xs font-black uppercase tracking-wider text-blue-700">PYQ PAPER LIBRARY</p>
            <h2 className="mt-1 text-2xl font-black">Choose your examination</h2>
            <p className="mt-2 text-sm text-slate-500">Open an exam to explore its year-wise papers and shifts. Paper availability depends on records currently added to SARJOM.</p>
          </div>
          <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {examCatalog.map(item => (
              <button key={item.name} type="button"
                onClick={() => { setExam(item.name); setSubject(""); setTopic(""); setYear(""); }}
                className={`rounded-2xl border p-5 text-left transition hover:border-blue-500 hover:bg-blue-50 ${exam.toLowerCase() === item.name.toLowerCase() ? "border-blue-700 bg-blue-50 ring-1 ring-blue-700" : "border-slate-200 bg-white"}`}>
                <p className="text-xs font-bold uppercase tracking-wide text-slate-500">{item.category}</p>
                <h3 className="mt-2 text-lg font-black">{item.name}</h3>
                <p className="mt-1 text-sm text-slate-600">{item.description}</p>
                <span className="mt-4 inline-block text-sm font-bold text-blue-700">Explore papers →</span>
              </button>
            ))}
          </div>
        </section>

        <section className="mt-6 rounded-2xl border border-slate-200 bg-white p-4 sm:p-6">
          <h2 className="font-black">Choose your exam and paper</h2>
          <div className="mt-4 grid gap-3 sm:grid-cols-2">
            <select aria-label="Exam" value={exam} onChange={e => setExam(e.target.value)} className="rounded-xl border p-3 text-sm">
              <option value="">All exams</option>
              {exams.map(x => <option key={x} value={x}>{x}</option>)}
              <option value="Odisha Police SI">Odisha Police SI</option>
              <option value="ASO">ASO</option>
            </select>
            <select aria-label="Year" value={year} onChange={e => setYear(e.target.value)} className="rounded-xl border p-3 text-sm">
              <option value="">All available years</option>
              {years.map(x => <option key={x} value={x}>{x}</option>)}
            </select>
            <select aria-label="Subject" value={subject} onChange={e => setSubject(e.target.value)} className="rounded-xl border p-3 text-sm">
              <option value="">All subjects</option>
              {subjects.map(x => <option key={x} value={x}>{x}</option>)}
            </select>
            <input aria-label="Topic" value={topic} onChange={e => setTopic(e.target.value)} placeholder="Filter by chapter or topic" className="rounded-xl border p-3 text-sm" />
          </div>
          <div className="mt-4 flex flex-wrap items-center gap-3">
            <label className="text-sm font-semibold">Practice timer</label>
            <select value={duration} onChange={e => setDuration(Number(e.target.value))} className="rounded-xl border p-2 text-sm">
              <option value={15}>15 minutes</option>
              <option value={30}>30 minutes</option>
              <option value={60}>60 minutes</option>
              <option value={90}>90 minutes</option>
            </select>
            <button type="button" onClick={() => { setExam(""); setSubject(""); setTopic(""); setYear(""); }} className={btn}>Clear filters</button>
            <button type="button" onClick={startAttempt} disabled={!filtered.length} className={primary}>Start attempt →</button>
          </div>
        </section>

        <section className="mt-6 rounded-2xl border border-slate-200 bg-white p-5 sm:p-6">
          <p className="text-xs font-black uppercase tracking-wider text-blue-700">YEAR → PAPER → SHIFT/SET</p>
          <h2 className="mt-2 text-xl font-black">{exam || "All examinations"}: paper catalogue</h2>
          <p className="mt-2 text-sm text-slate-500">Paper entries are derived from existing question metadata. No years, shifts or paper counts are invented.</p>
          {paperGroups.filter(p =>
            (!exam || p.exam.toLowerCase().includes(exam.toLowerCase())) &&
            (!year || p.year === year)
          ).length > 0 ? (
            <div className="mt-4 space-y-3">
              {paperGroups.filter(p =>
                (!exam || p.exam.toLowerCase().includes(exam.toLowerCase())) &&
                (!year || p.year === year)
              ).map(p => (
                <article key={`${p.exam}-${p.year}-${p.paper}-${p.shift}`} className="rounded-xl border p-4">
                  <div className="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <h3 className="font-black">{p.exam}</h3>
                      <p className="mt-1 text-sm text-slate-600">{p.year} · {p.paper} · {p.shift}</p>
                      <p className="mt-1 text-xs text-slate-500">{p.count} question record(s)</p>
                    </div>
                    <button type="button"
                      onClick={() => { setExam(p.exam); setYear(p.year === "Year not specified" ? "" : p.year); setSubject(""); setTopic(""); }}
                      className="rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white">
                      Open questions
                    </button>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div className="mt-4 rounded-xl border border-dashed p-5">
              <h3 className="font-bold">No paper entries available yet</h3>
              <p className="mt-2 text-sm leading-6 text-slate-500">The dashboard is ready, but no year/paper/shift records are currently available for this selection. Add the actual paper metadata when your papers are ready.</p>
            </div>
          )}
        </section>
        {loading && <p className="py-12 text-center text-slate-500">Loading questions...</p>}
        {error && <p role="alert" className="mt-5 rounded-xl bg-red-50 p-4 text-red-700">{error}</p>}
        {!loading && !error && filtered.length === 0 && <section className="mt-6 rounded-2xl border border-dashed p-8 text-center">
          <h2 className="font-black">No questions match this selection yet</h2>
          <p className="mt-2 text-sm leading-6 text-slate-500">You can keep building the exam catalogue now. Papers and questions will appear here when they are added to SARJOM records. No sample questions are inserted.</p>
        </section>}
        <section className="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {filtered.map(item => <article key={item.id} className="rounded-2xl border bg-white p-5">
            <p className="text-xs font-bold text-slate-500">{text(item.metadata.examName || item.metadata.exam) || "Exam"} · {text(item.metadata.year) || "Year not specified"}</p>
            <h2 className="mt-2 font-black">{text(item.metadata.subject) || "Subject not specified"}</h2>
            <p className="mt-2 line-clamp-3 text-sm text-slate-600">{text(item.metadata.question)}</p>
            <button type="button" onClick={() => { setExam(text(item.metadata.examName || item.metadata.exam)); setSubject(text(item.metadata.subject)); setTopic(""); setYear(text(item.metadata.year)); }} className="mt-4 text-sm font-bold text-blue-700">Practise this selection →</button>
          </article>)}
        </section>
      </>}

      {mode === "attempt" && q && <div className="mt-6 grid gap-5 lg:grid-cols-[1fr_280px]">
        <section className="rounded-2xl border bg-white p-5 sm:p-7">
          <div className="flex flex-wrap items-center justify-between gap-3">
            <p className="text-xs font-bold text-slate-500">QUESTION {current + 1} OF {filtered.length}</p>
            <p className={`rounded-lg px-3 py-2 font-black tabular-nums ${seconds < 60 ? "bg-red-100 text-red-700" : "bg-slate-100"}`}>Time left {fmt(seconds)}</p>
          </div>
          <p className="mt-4 text-xs font-bold text-slate-500">{text(q.metadata.subject)} {text(q.metadata.topic) && `· ${text(q.metadata.topic)}`}</p>
          <h2 className="mt-3 text-xl font-black leading-8">{text(q.metadata.question)}</h2>
          <div className="mt-6 grid gap-3">
            {options.map((option, i) => <button key={`${q.id}-${i}`} type="button" onClick={() => setAnswers(old => ({ ...old, [q.id]: i }))} className={`${btn} p-4 text-left ${answers[q.id] === i ? "border-blue-600 bg-blue-50" : "border-slate-200"}`}>
              {String.fromCharCode(65 + i)}. {option}
            </button>)}
          </div>
          <div className="mt-6 flex flex-wrap gap-2">
            <button type="button" disabled={current === 0} onClick={() => setCurrent(i => i - 1)} className={btn}>← Previous</button>
            <button type="button" onClick={() => setReview(old => old.includes(q.id) ? old.filter(id => id !== q.id) : [...old, q.id])} className={`${btn} ${review.includes(q.id) ? "border-amber-500 bg-amber-50" : ""}`}>{review.includes(q.id) ? "★ Marked for review" : "☆ Mark for review"}</button>
            <button type="button" disabled={current === filtered.length - 1} onClick={() => setCurrent(i => i + 1)} className={primary}>Next →</button>
            <button type="button" onClick={submitAttempt} className="rounded-xl bg-emerald-700 px-5 py-3 text-sm font-bold text-white">Submit attempt</button>
          </div>
        </section>
        <aside className="h-fit rounded-2xl border bg-white p-5">
          <h2 className="font-black">Question palette</h2>
          <div className="mt-4 grid grid-cols-5 gap-2">
            {filtered.map((item, i) => <button key={item.id} type="button" onClick={() => setCurrent(i)} aria-label={`Go to question ${i + 1}`} className={`rounded-lg border p-2 text-sm font-bold ${current === i ? "border-blue-700 bg-blue-700 text-white" : review.includes(item.id) ? "border-amber-400 bg-amber-50" : answers[item.id] !== undefined ? "border-emerald-400 bg-emerald-50" : "border-slate-200"}`}>{i + 1}</button>)}
          </div>
          <div className="mt-5 space-y-2 text-sm text-slate-600">
            <p>Answered: <b>{answered}</b></p><p>Unanswered: <b>{filtered.length - answered}</b></p><p>Marked for review: <b>{review.length}</b></p>
          </div>
        </aside>
      </div>}

      {mode === "result" && <section className="mt-6 rounded-2xl border bg-white p-5 sm:p-8">
        <p className="text-xs font-black uppercase tracking-wider text-blue-700">Attempt completed</p>
        <h2 className="mt-2 text-3xl font-black">Your result</h2>
        <div className="mt-5 grid gap-3 sm:grid-cols-4">
          <div className="rounded-xl bg-slate-50 p-4"><p className="text-sm text-slate-500">Score</p><p className="text-2xl font-black">{correct}/{filtered.length}</p></div>
          <div className="rounded-xl bg-emerald-50 p-4"><p className="text-sm text-slate-500">Correct</p><p className="text-2xl font-black">{correct}</p></div>
          <div className="rounded-xl bg-red-50 p-4"><p className="text-sm text-slate-500">Wrong</p><p className="text-2xl font-black">{filtered.filter(item => answers[item.id] !== undefined && answers[item.id] !== item.metadata.answerIndex).length}</p></div>
          <div className="rounded-xl bg-amber-50 p-4"><p className="text-sm text-slate-500">Unattempted</p><p className="text-2xl font-black">{filtered.filter(item => answers[item.id] === undefined).length}</p></div>
        </div>
        <p className="mt-3 text-sm text-slate-500">Accuracy: {answered ? Math.round(correct / answered * 100) : 0}% of attempted questions. Results are shown for this session; persistent account history is not connected yet.</p>
        <div className="mt-6 space-y-4">
          {filtered.map((item, i) => {
            const opts = list(item.metadata.options);
            const right = item.metadata.answerIndex as number;
            return <article key={item.id} className="rounded-xl border p-4">
              <p className="text-xs font-bold text-slate-500">QUESTION {i + 1} · {text(item.metadata.subject)}</p>
              <h3 className="mt-2 font-bold">{text(item.metadata.question)}</h3>
              <p className="mt-2 text-sm">Your answer: {answers[item.id] === undefined ? "Not attempted" : opts[answers[item.id]]}</p>
              <p className="mt-1 text-sm font-semibold text-emerald-700">Correct answer: {opts[right]}</p>
              {text(item.metadata.explanation) && <p className="mt-2 text-sm leading-6 text-slate-600">{text(item.metadata.explanation)}</p>}
              {item.officialUrl && <a className="mt-2 inline-block text-sm font-bold text-blue-700 underline" href={item.officialUrl} target="_blank" rel="noopener noreferrer">Source ↗</a>}
            </article>;
          })}
        </div>
        <button type="button" onClick={() => setMode("browse")} className={`${primary} mt-6`}>Back to PYQ catalogue</button>
      </section>}

      <p className="mt-8 text-xs leading-5 text-slate-500">Attempt answers currently remain in this browser session. Account-level history, revision scheduling and cross-device sync can be connected to the existing SARJOM storage architecture in a later step.</p>
      <Link href="/exams" className="mt-4 inline-block text-sm font-bold text-blue-700">Browse exams →</Link>
    </main>
  );
}

export default function PyqPage() {
  return <Suspense fallback={<main className="mx-auto max-w-6xl p-8">Loading PYQs...</main>}><PyqContent /></Suspense>;
}



